# PlanYours Backend Environment Configuration
# ALL KEYS ARE OPTIONAL. The app operates fully offline with deterministic fallbacks when keys/db are absent.

# Server Configuration (Optional, defaults to 5001)
PORT=5001
NODE_ENV=development

# Allowed Frontend URLs for CORS (comma-separated, Optional)
CLIENT_URL=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# Recommender Engine Selection: rule | llm | ml (Optional, default: rule)
# If set to llm or ml and provider times out or fails, automatically falls back to rule.
RECOMMENDER=rule

# Database (Optional - without Mongo, saves automatically to data/store.json)
MONGO_URI=mongodb://localhost:27017/planyours
JWT_SECRET=super_secret_jwt_key_dev_mode_only

# Weather Provider (Optional - falls back to data/climate.json climatology table)
OPENWEATHER_KEY=

# Routing Provider (Optional - falls back to Haversine distance x 1.3 road factor)
OPENROUTE_KEY=

# Places & Attractions (Optional - falls back to data/places.seed.json curated dataset)
OPENTRIPMAP_KEY=
GEOAPIFY_KEY=
FOURSQUARE_API_KEY=

# Transport & Booking (Optional - falls back to modal speed and distance formulas)
TRAVELPAYOUTS_API_TOKEN=
AVIATIONSTACK_KEY=
TRANSPORT_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST_TRAINS=
RAPIDAPI_HOST_BUSES=
BOOKING_API_KEY=
BOOKING_API_HOST=
